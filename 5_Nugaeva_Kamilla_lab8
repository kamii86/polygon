// Главная функция программы
int main() {
    Graph graph("/Users/kamillanugaeva/CLionProjects/polygon/projects/lab8/spb_graph.txt"); // Загружаем граф из файла

    unordered_set<Node*> visited_dfs; // Множество посещенных узлов для DFS
    double mylat = 59.987187; // Широта начальной точки
    double mylon = 30.178429; // Долгота начальной точки
    double finlat = 59.956363; // Широта конечной точки
    double finlon = 30.310011; // Долгота конечной точки

    Node* closest_node = graph.find_closest_node(mylat, mylon); // Поиск ближайшего узла к начальной точке
    Node* finish_node = graph.find_closest_node(finlat, finlon); // Поиск ближайшего узла к конечной точке

    // DFS
    clock_t start_dfs = clock(); // Начало измерения времени
    double distance_to_finish_dfs = dfs(graph.nodes, closest_node, finish_node, visited_dfs); // Поиск пути DFS
    clock_t end_dfs = clock(); // Конец измерения времени
    cout << "Расстояние до ИТМО по оценке DFS: " << distance_to_finish_dfs << endl;

    // BFS
    clock_t start_bfd = clock(); // Начало измерения времени
    double distance_to_finish_bfs = bfs(graph.nodes, closest_node, finish_node); // Поиск пути BFS
    clock_t end_bfs = clock(); // Конец измерения времени
    cout << "Расстояние до ИТМО по оценке BFS: " << distance_to_finish_bfs << endl;

    // Алгоритм Дейкстры
    clock_t start_djkstra = clock(); // Начало измерения времени
    unordered_map<Node*, double> distances_dijkstra = dijkstra(graph.nodes, closest_node); // Поиск пути Дейкстрой
    clock_t end_djkstra = clock(); // Конец измерения времени
    double distance_to_finish_dijkstra = distances_dijkstra[finish_node]; // Получение расстояния
    cout << "Расстояние до ИТМО по оценке Дейкстры: " << distance_to_finish_dijkstra << endl;

    // A*
    clock_t start_a_star = clock(); // Начало измерения времени
    unordered_map<Node*, double> distances_a_star = a_star(graph.nodes, closest_node, finish_node); // Поиск пути A*
    clock_t end_a_star = clock(); // Конец измерения времени
    double distance_to_finish_a_star = distances_a_star[finish_node]; // Получение расстояния
    cout << "Расстояние до ИТМО по оценке A*: " << distance_to_finish_a_star << endl;

    // Вывод времени выполнения алгоритмов
    double time_djkstra = (double)(end_djkstra - start_djkstra) / CLOCKS_PER_SEC; // Время работы Дейкстры
    double time_a_star = (double)(end_a_star - start_a_star) / CLOCKS_PER_SEC; // Время работы A*
    double time_dfs = (double)(end_dfs - start_dfs) / CLOCKS_PER_SEC; // Время работы DFS
    double time_bfs = (double)(end_bfs - start_bfd) / CLOCKS_PER_SEC; // Время работы BFS
    cout << "Время выполнения алгоритма DFS: " << time_dfs << endl;
    cout << "Время выполнения алгоритма BFS: " << time_bfs << endl;
    cout << "Время выполнения алгоритма Дейкстры: " << time_djkstra << endl;
    cout << "Время выполнения алгоритма A*: " << time_a_star << endl;


{
    // Запуск всех тестов
    test_dfs();
    test_bfs();
    test_dijkstra();
    test_a_star();

    std::cout << "All tests passed!\n";
    return 0;
}



